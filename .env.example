# Port to listen on (Heroku/Render set this automatically)
PORT=3000

# Password for the /admin dashboard (HTTP Basic auth — any username, this password).
# REQUIRED in production. Leaving it unset falls back to "changeme".
ADMIN_PASSWORD=changeme

# Shopify webhook signing secret. When set, /webhooks/shopify/orders verifies the
# X-Shopify-Hmac-Sha256 signature. Leave empty only for local development.
SHOPIFY_WEBHOOK_SECRET=

# Public base URL used to build referral links (e.g. https://giveaways.groundeddrops.com).
# If unset, the app infers it from the incoming request.
PUBLIC_BASE_URL=

# Your Shopify store domain (e.g. groundeddrops.com). When set, the entry page
# can only be embedded on your store, and CSP/webhook checks are tightened.
SHOP_DOMAIN=

# Automatic monthly lifecycle (on by default): when a giveaway's month ends the
# app draws the winner, prepares the announcement + winner emails, and opens
# the next month's giveaway. Set to "false" to run everything manually.
AUTO_DRAW=true

# SMTP settings for sending the drafted emails from the admin dashboard.
# Leave unset to just copy/paste drafts into your own email tool.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Grounded Drops <giveaways@groundeddrops.com>"

# Tuning knobs
PURCHASE_TICKETS_PER_ORDER=5
REFERRAL_TICKET_CAP=10

# Where to store the SQLite file (defaults to ./giveaways.db)
DB_PATH=
