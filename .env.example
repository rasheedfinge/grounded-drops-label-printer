# ---- Copy this file to ".env" and fill in the values ----

# Your store's *.myshopify.com domain (NOT the custom domain).
# Find it in Shopify admin → Settings → Domains (the one ending in myshopify.com).
SHOPIFY_SHOP=your-store.myshopify.com

# Admin API access token from the custom app you create (starts with shpat_).
# Shopify admin → Settings → Apps and sales channels → Develop apps → your app
# → API credentials → Admin API access token.
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin API version. Leave as-is unless you have a reason to change it.
SHOPIFY_API_VERSION=2025-01

# Secret used to sign "edit your order" links. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LINK_SIGNING_SECRET=

# Password for the /admin settings screen (choose something strong).
ADMIN_PASSWORD=

# Shown in the portal header and emails.
STORE_NAME=Grounded Drops

# Public URL where this app is hosted (used to build edit links). No trailing slash.
PUBLIC_URL=https://orders.groundeddrops.com.au

# "From" address for balance invoices. Must be a verified store/staff email in
# Shopify, otherwise Shopify rejects the send. Leave blank to use Shopify's default.
INVOICE_FROM_EMAIL=

# Port (most hosts set this automatically).
PORT=3000

# ---- Optional overrides (these win over the /admin screen, so critical config
#      survives redeploys on hosts with an ephemeral filesystem) ----
# EDIT_WINDOW_MINUTES=60
# UPSELL_DISCOUNT_PERCENT=15
# UPSELL_VARIANT_IDS=gid://shopify/ProductVariant/123,gid://shopify/ProductVariant/456
# ALLOW_ADDRESS_EDIT=true
# ALLOW_VARIANT_SWAP=true
# ALLOW_UPSELL=true
