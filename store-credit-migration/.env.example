# Copy this file to ".env" and fill in your values.
# (.env is gitignored — never commit your real token.)

# Your myshopify domain (NOT the public domain). Find it in
# Shopify Admin → Settings → Domains, it ends in .myshopify.com
SHOPIFY_STORE_DOMAIN=grounded-drops.myshopify.com

# Admin API access token from your custom app (starts with shpat_)
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — defaults to 2025-01. Only change if you know you need to.
SHOPIFY_API_VERSION=2025-01

# Optional — overrides the shop's default currency for the credit issued.
# Leave blank to use the store's default currency automatically.
STORE_CURRENCY=
